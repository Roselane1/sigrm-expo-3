# Copie este arquivo para ".env" na raiz do projeto e ajuste a URL.
#
# Em desenvolvimento local, use o endereço IP do seu computador na rede
# (não "localhost" — o celular não entende isso como sendo o seu PC).
# Descubra o IP com "ipconfig" (Windows) e procure algo como 192.168.x.x.
EXPO_PUBLIC_API_URL=http://192.168.0.10:4000

# Depois de publicar o backend (veja o README do sigrm-server), troque para
# a URL pública, por exemplo:
# EXPO_PUBLIC_API_URL=https://sigrm-server.onrender.com
